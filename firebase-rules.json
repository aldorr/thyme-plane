{
  "rules": {
    ".read": "auth.uid !== null && root.child('users').child(auth.uid).exists()",
    ".write": "auth.uid !== null && root.child('users').child(auth.uid).exists()",
    "users": {
      "$user_id": {
        ".read": "auth.uid === $user_id || auth.uid !== null",
        ".write": "auth.uid === $user_id || auth.uid !== null"
      }
    },
    "customerentries": {
      ".read": "auth.uid !== null",
      ".write": "auth.uid !== null"
    }
  }
} 